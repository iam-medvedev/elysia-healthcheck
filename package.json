{
  "name": "elysia-healthcheck",
  "version": "1.0.0",
  "description": "Healthcheck plugin for Elysia.js",
  "repository": "https://github.com/iam-medvedev/elysia-healthcheck.git",
  "homepage": "https://github.com/iam-medvedev/elysia-healthcheck#readme",
  "bugs": "https://github.com/iam-medvedev/elysia-healthcheck/issues",
  "author": "Ilya Medvedev <ilya@medvedev.im>",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*",
    "package.json"
  ],
  "keywords": [
    "elysia",
    "healthcheck",
    "health",
    "check"
  ],
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "build": "rm -rf ./dist && NODE_ENV=production tsc --project tsconfig.dist.json",
    "commit": "git-cz",
    "prepare": "husky",
    "release": "semantic-release",
    "types": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@elysiajs/eden": "^1.4.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/bun": "^1.2.22",
    "cz-conventional-changelog": "^3.3.0",
    "elysia": "latest",
    "git-cz": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.9",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "elysia": ">=1.3.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 120
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,json,md}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
